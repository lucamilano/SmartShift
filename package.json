{
  "name": "smartshift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run deploy:worker && npm run deploy:pages",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:worker": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:pages": "wrangler pages deploy --cwd cloudflare-pages --branch main",
    "auth:provision": "node scripts/provision-user.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.575.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260917.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "wrangler": "4.133.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
